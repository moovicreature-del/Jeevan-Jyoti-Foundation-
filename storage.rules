rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow public read for NGO website assets, logos, certificate seals, and event media
      allow read: if true;
      // Allow authorized writes or valid image/media uploads under 50MB
      allow write: if request.auth != null || (request.resource.size < 50 * 1024 * 1024);
    }
  }
}
