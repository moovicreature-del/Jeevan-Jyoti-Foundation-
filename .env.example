# =============================================================================
# TWILIO WHATSAPP API CONFIGURATION
# =============================================================================
# 1. Sign up at https://www.twilio.com/ and copy Account SID and Auth Token
# 2. Go to Messaging > Try it out > Send a WhatsApp message (Twilio Sandbox)
# 3. For Sandbox testing, TWILIO_WHATSAPP_NUMBER is whatsapp:+14155238886
# 4. For Production, use your approved Twilio WhatsApp Sender Number
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SMS Gateway Dispatch Service (Fast2SMS for India real mobile OTP)
FAST2SMS_API_KEY=

# Meta / WhatsApp Business Cloud API Configuration (Alternative Gateway)
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

PORT=3000
GEMINI_API_KEY=

# Automated Email Dispatch Service (Optional SMTP Configuration)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=

# =============================================================================
# ADMIN REAL-TIME TELEGRAM & SLACK BOT NOTIFICATIONS
# =============================================================================
# 1. Telegram: Create bot via @BotFather, get Token. Get chat_id from @userinfobot or group
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 2. Slack: Create an Incoming Webhook in your Slack Workspace
SLACK_WEBHOOK_URL=

