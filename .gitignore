# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Node dependencies (MUST NEVER BE COMMITTED TO GITHUB)
node_modules/
node_modules
/.pnp
.pnp.js

# Production build outputs
dist/
dist
dist-ssr
build/
*.local

# Editor files & OS artifacts
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.tmp

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Archive files, large binaries & backups (Prevents GitHub API payload size error: "Request contains an invalid argument")
*.zip
*.tar.gz
*.tgz
*.rar
*.7z
*.bak
*.backup
backups/

# Cache directories
.cache/
.vite/
.eslintcache
